{
  "name": "eureka/eureka-appplication-web",
  "description": "Web Application Eureka Framework - Template App",
  "minimum-stability": "stable",
  "type": "project",
  "license": "MIT",

  "authors": [
    {
      "name": "Romain Cottard",
      "role": "Developer"
    }
  ],

  "autoload": {
    "psr-4": {
      "Application\\": "./src",
      "Application\\Script\\": "./scripts"
    }
  },

  "autoload-dev": {
    "psr-4": {
      "Application\\Tests\\Unit\\": "./tests/Unit"
    }
  },

  "config": {
    "sort-packages": true
  },

  "require": {
    "php": ">=8.3",
    "ext-json": "*",
    "ext-session": "*",

    "eureka/component-console": "^7.0.0",
    "eureka/component-database": "^4.0.0",
    "eureka/component-deployer": "^4.0.0",
    "eureka/component-orm": "^7.2.0",
    "eureka/component-web": "^7.1.0",
    "eureka/kernel-http": "^7.0.0",
    "eureka/kernel-console": "^7.0.0",
    "lcobucci/clock": "^3.5.0",
    "nyholm/psr7": "^1.8.2",
    "psr/log": "^3.0.2",
    "psr/clock": "^1.0.0",
    "psr/container": "^2.0.2",
    "psr/http-message": "^2.0.0",
    "psr/http-server-handler": "^1.0.2",
    "psr/http-server-middleware": "^1.0.2",
    "symfony/asset-mapper": "^7.4.3",
    "symfony/cache": "^7.4.3||^8.0.0",
    "symfony/console": "^7.4.3||^8.0.0",
    "symfony/routing": "^7.4.3||^8.0.0",
    "symfony/finder": "^7.4.3||^8.0.0",
    "twig/twig": "^3.22.2"
  },

  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.92.4",
    "phpstan/phpstan": "^2.1.33",
    "phpstan/phpstan-deprecation-rules": "^2.0.3",
    "phpstan/phpstan-phpunit": "^2.0.11",
    "phpstan/phpstan-strict-rules": "^2.0.7",
    "phpunit/phpcov": "^11.0.3",
    "phpunit/phpunit": "^12.5.4",
    "shipmonk/composer-dependency-analyser": "^1.8.4"
  }
}
